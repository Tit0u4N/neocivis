meta {
  name: Get published article by id
  type: http
  seq: 2
}

get {
  url: {{url}}/api/citizen/articles/{{citizenArticleId}}
  body: none
  auth: inherit
}

script:pre-request {
  // Fallback si la variable n'a pas été définie par "Get published articles"
  if (!bru.getVar('citizenArticleId')) {
    bru.setVar('citizenArticleId', '00000000-0000-0000-0000-000000000000');
  }
}

script:post-response {
  test("Status is 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

