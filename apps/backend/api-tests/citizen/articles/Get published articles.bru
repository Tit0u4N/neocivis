meta {
  name: Get published articles
  type: http
  seq: 1
}

get {
  url: {{url}}/api/citizen/articles
  body: none
  auth: inherit
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Body is object", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.total).to.be.an('number');
    expect(body.page).to.be.an('number');
    expect(body.limit).to.be.an('number');
    expect(body.totalPages).to.be.an('number');
  });
  
  test("Data is a list", function() {
    const data = res.getBody().data;
    expect(data).to.be.an('array');
    // Optionnel: garder un id pour la requête suivante si possible
    if (data.length > 0 && data[0] && data[0].id) {
      bru.setVar('citizenArticleId', data[0].id);
    }
  });
  
  test("Seeded published articles are present", function() {
    const data = res.getBody().data;
    const ids = data.map((a) => a.id);
  
    expect(ids).to.include('11111111-1111-1111-1111-111111111111');
    expect(ids).to.include('22222222-2222-2222-2222-222222222222');
    expect(ids).to.include('33333333-3333-3333-3333-333333333333');
  });
  
  test("Seeded draft article is not returned in citizen published list", function() {
    const data = res.getBody().data;
    const ids = data.map((a) => a.id);
    expect(ids).to.not.include('44444444-4444-4444-4444-444444444444');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
