meta {
  name: Get published articles
  type: http
  seq: 1
}

get {
  url: {{url}}/api/citizen/cities/{{cityNiceId}}/articles
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');

  let cityId = bru.getVar('cityNiceId') ?? bru.getEnvVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/citizen/user/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    const memberships = me.data?.memberships ?? [];
    const nice = Array.isArray(memberships) ? memberships.find((m) => m && m.name === 'Nice') : null;
    if (!nice?.id) {
      throw new Error('Nice membership not found in /user/me');
    }
    cityId = nice.id;
    bru.setVar('cityNiceId', cityId);
  }
  req.setUrl(`${baseUrl}/api/citizen/cities/${cityId}/articles`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body is object", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.total).to.be.an('number');
    expect(body.page).to.be.an('number');
    expect(body.limit).to.be.an('number');
    expect(body.totalPages).to.be.an('number');
  });

  test("Data is a list", function() {
    const data = res.getBody().data;
    expect(data).to.be.an('array');
    if (data.length > 0 && data[0] && data[0].id) {
      bru.setVar('citizenArticleId', data[0].id);
    }
  });

  test("Seeded published articles are present", function() {
    const data = res.getBody().data;
    const ids = data.map((a) => a.id);

    expect(ids).to.include('11111111-1111-1111-1111-111111111111');
    expect(ids).to.include('22222222-2222-2222-2222-222222222222');
    expect(ids).to.include('33333333-3333-3333-3333-333333333333');
  });

  test("Seeded draft article is not returned in citizen published list", function() {
    const data = res.getBody().data;
    const ids = data.map((a) => a.id);
    expect(ids).to.not.include('44444444-4444-4444-4444-444444444444');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
