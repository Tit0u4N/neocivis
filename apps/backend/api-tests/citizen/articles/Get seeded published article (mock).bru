meta {
  name: Get seeded published article (mock)
  type: http
  seq: 0
}

get {
  url: {{url}}/api/citizen/cities/{{cityNiceId}}/articles/11111111-1111-1111-1111-111111111111
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');

  let cityId = bru.getVar('cityNiceId') ?? bru.getEnvVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/citizen/user/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    const memberships = me.data?.memberships ?? [];
    const nice = Array.isArray(memberships) ? memberships.find((m) => m && m.name === 'Nice') : null;
    if (!nice?.id) {
      throw new Error('Nice membership not found in /user/me');
    }
    cityId = nice.id;
    bru.setVar('cityNiceId', cityId);
  }
  req.setUrl(`${baseUrl}/api/citizen/cities/${cityId}/articles/11111111-1111-1111-1111-111111111111`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body matches seeded article", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.id).to.equal('11111111-1111-1111-1111-111111111111');
    expect(body.status).to.equal('published');
    expect(body.translation).to.be.an('object');

    const fr = body.translation;
    expect(fr).to.be.an('object');
    expect(fr.title).to.equal('Bienvenue dans notre ville');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
