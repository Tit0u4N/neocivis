meta {
  name: Delete profile picture
  type: http
  seq: 7
}

delete {
  url: {{url}}/api/citizen/user/me/profile-picture
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body has success flag", function() {
    expect(res.getBody()).to.have.property('success', true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
