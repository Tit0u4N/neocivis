meta {
  name: Get by ids
  type: http
  seq: 4
}

get {
  url: {{url}}/api/citizen/user/by-ids?ids=1
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

script:post-response {
  test("Status is 200 or 400", function() {
    // 400 si l'instance n'a pas ce user id (ou body invalid), sinon 200.
    expect([200, 400]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
    test("Body is list of users (public dto)", function() {
      const body = res.getBody();
      expect(body).to.be.an('array');
      body.forEach(user => {
        expect(user).to.have.property('id');
        expect(user).to.have.property('username');
        expect(user).to.have.property('firstName');
        expect(user).to.have.property('lastName');
        expect(user).to.have.property('profilePictureUrl');
        expect(user).to.not.have.property('email');
        expect(user).to.not.have.property('role');
        expect(user).to.not.have.property('keycloakId');
      });
    });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
