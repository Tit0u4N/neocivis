script:pre-request {
  // -----------------------------------------------------------------------
  // Pre-request CENTRAL pour toute la collection.
  //
  // Objectif :
  //   Pull en parallèle un token Keycloak pour CHACUN des trois acteurs
  //   (admin, employee, citizen) une seule fois par run, et les exposer
  //   sous forme de variables runtime (`tokenAdmin`, `tokenEmployee`,
  //   `tokenCitizen`) que chaque requête ira lire dans son propre
  //   pre-script pour injecter le bon header `Authorization`.
  //
  // Comportement :
  //   - Tokens cachés en mémoire (`bru.setVar`) : refetchés une seule
  //     fois par lancement complet du runner (suffisant : la durée d'un
  //     run < TTL d'un access_token).
  //   - Si une combinaison user/password est manquante côté env (ex.
  //     password_municipality non set), on lève une erreur explicite
  //     pour ne pas laisser un test passer faussement.
  // -----------------------------------------------------------------------

  const axios = require('axios');

  const tokenUrl = bru.getEnvVar('tokenUrl');
  const clientId = bru.getEnvVar('clientId');
  if (!tokenUrl || !clientId) {
    throw new Error('Missing env vars: tokenUrl / clientId');
  }

  const passwordCitizen = bru.getEnvVar('password_citizen');
  const passwordMunicipality = bru.getEnvVar('password_municipality');

  const actors = [
    {
      key: 'tokenAdmin',
      username: bru.getEnvVar('username_municipality_admin'),
      password: passwordMunicipality,
    },
    {
      key: 'tokenEmployee',
      username: bru.getEnvVar('username_municipality_employee'),
      password: passwordMunicipality,
    },
    {
      key: 'tokenCitizen',
      username: bru.getEnvVar('username_citizen'),
      password: passwordCitizen,
    },
  ];

  for (const a of actors) {
    if (!a.username || !a.password) {
      throw new Error(
        `Missing env vars for ${a.key} (username/password). Check your environment file and process.env.`,
      );
    }
  }

  // Évite de re-fetch si déjà en cache pour ce run.
  const fetched = await Promise.all(
    actors.map(async (a) => {
      const cached = bru.getVar(a.key);
      if (cached) {
        return { key: a.key, token: cached };
      }
      const body =
        'grant_type=password' +
        '&client_id=' + encodeURIComponent(clientId) +
        '&username=' + encodeURIComponent(a.username) +
        '&password=' + encodeURIComponent(a.password);
      const resp = await axios.post(tokenUrl, body, {
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      });
      return { key: a.key, token: resp.data.access_token };
    }),
  );

  for (const { key, token } of fetched) {
    bru.setVar(key, token);
  }
}
