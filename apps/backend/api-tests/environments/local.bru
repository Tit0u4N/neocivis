vars {
  url: http://localhost:7071
  tokenUrl: https://auth.neocivis.cloud/realms/neocivis-dev/protocol/openid-connect/token
  clientId: client-for-test
  username_citizen: citizen1
  username_municipality_admin: admin-nice
  username_municipality_employee: employee-nice1
  password_citizen: {{process.env.password_citizen}}
  password_municipality: {{process.env.password_municipality}}
  cached: {{process.env.CACHED}}
  keycloak_admin_client_id: hono-backend
  keycloak_admin_client_secret: {{process.env.KEYCLOAK_CLIENT_SECRET}}
}
