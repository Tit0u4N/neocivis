meta {
  name: 02 - List roles for my city
  type: http
  seq: 2
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/roles
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  if (!baseUrl || !auth) {
    throw new Error('Missing url or Authorization');
  }
  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('No city in /api/municipality/user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/roles`);
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns the seeded roles for Nice", function() {
    const body = res.getBody();
    expect(body).to.be.an('array');
    const names = body.map((r) => r.name);
    expect(names).to.include('Modérateur Forum');
    expect(names).to.include('Communication');
    expect(names).to.include('Gestionnaire Signalements');
  });

  test("Each role has id, cityId and permissions[]", function() {
    const body = res.getBody();
    for (const r of body) {
      expect(r).to.have.property('id').that.is.a('string');
      expect(r).to.have.property('cityId').that.is.a('string');
      expect(r).to.have.property('name').that.is.a('string');
      expect(r).to.have.property('permissions').that.is.an('array');
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
