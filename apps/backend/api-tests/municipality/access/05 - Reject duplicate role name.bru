meta {
  name: 05 - Reject duplicate role name
  type: http
  seq: 5
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/roles
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Modérateur Forum",
    "description": "doublon",
    "permissions": []
  }
}

script:pre-request {
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
  const cityId = me.data?.city?.id;
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/roles`);
}

tests {
  test("Status is 409 Conflict", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("Returns ApiErrorDto", function() {
    const body = res.getBody();
    expect(body).to.have.property('error').that.is.a('string');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
