meta {
  name: 06 - Delete role
  type: http
  seq: 6
}

delete {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/roles/{{createdRoleId}}
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  let cityId = bru.getVar('cityNiceId');
  let roleId = bru.getVar('createdRoleId');

  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  if (!roleId) {
    const list = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/roles`, { headers: { Authorization: auth } });
    const role = (list.data || []).find((r) => r.name === 'Bruno Test Role');
    if (!role) {
      throw new Error('Bruno Test Role already deleted, nothing to do');
    }
    roleId = role.id;
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/roles/${roleId}`);
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns OperationSuccessDto", function() {
    const body = res.getBody();
    expect(body).to.have.property('success', true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
