meta {
  name: 00 - Seed check (mock 111...)
  type: http
  seq: 0
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles/11111111-1111-1111-1111-111111111111
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles/11111111-1111-1111-1111-111111111111`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body matches seeded article", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.id).to.equal('11111111-1111-1111-1111-111111111111');
    expect(body.status).to.equal('published');
    expect(body.cityId).to.be.a('string');
    expect(body.translations).to.be.an('array');

    const fr = body.translations.find((t) => t.locale === 'fr');
    expect(fr).to.be.an('object');
    expect(fr.title).to.equal('Bienvenue dans notre ville');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
