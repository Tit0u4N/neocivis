meta {
  name: 02 - Get all articles
  type: http
  seq: 2
}

get {
  url: {{url}}/api/municipality/articles
  body: none
  auth: inherit
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Body is list", function() {
    const body = res.getBody();
    expect(body).to.be.an('array');
  });

  test("Seeded mock articles are present", function() {
    const body = res.getBody();
    const ids = body.map((a) => a.id);

    expect(ids).to.include('11111111-1111-1111-1111-111111111111');
    expect(ids).to.include('22222222-2222-2222-2222-222222222222');
    expect(ids).to.include('33333333-3333-3333-3333-333333333333');
    expect(ids).to.include('44444444-4444-4444-4444-444444444444');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
