meta {
  name: 02 - Get all articles
  type: http
  seq: 2
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Body is list", function() {
    const body = res.getBody();
    expect(body).to.be.an('array');
  });

  test("Seeded mock articles are present for Nice", function() {
    const body = res.getBody();
    const ids = body.map((a) => a.id);

    expect(ids).to.include('11111111-1111-1111-1111-111111111111');
    expect(ids).to.include('22222222-2222-2222-2222-222222222222');
    expect(ids).to.include('33333333-3333-3333-3333-333333333333');
    expect(ids).to.include('44444444-4444-4444-4444-444444444444');
    expect(body.every((a) => a.cityId === bru.getVar('cityNiceId'))).to.be.true;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
