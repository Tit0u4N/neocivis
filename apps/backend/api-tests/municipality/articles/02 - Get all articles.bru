meta {
  name: 02 - Get all articles
  type: http
  seq: 2
}

get {
  url: {{url}}/api/municipality/articles
  body: none
  auth: inherit
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Body is list", function() {
    const body = res.getBody();
    expect(body).to.be.an('array');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
