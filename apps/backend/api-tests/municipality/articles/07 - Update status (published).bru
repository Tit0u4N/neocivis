meta {
  name: 07 - Update status (published)
  type: http
  seq: 7
}

patch {
  url: {{url}}/api/municipality/articles/{{articleId}}/status
  body: json
  auth: inherit
}

body:json {
  {
    "status": "published"
  }
}

script:pre-request {
  if (!bru.getVar('articleId')) {
    throw new Error('Missing articleId. Run "01 - Create article" first.');
  }
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

