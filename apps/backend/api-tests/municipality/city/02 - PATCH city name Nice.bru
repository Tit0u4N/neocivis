meta {
  name: PATCH city description (idempotent)
  type: http
  seq: 32
}

patch {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

body:json {
  {
    "description": "Ville de Nice"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  if (!baseUrl || !auth) {
    console.log('Missing url or Authorization');
    return;
  }
  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('No city in /api/municipality/user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}`);
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response includes id and description", function() {
    const body = res.getBody();
    expect(body).to.have.property('id');
    expect(body).to.have.property('description');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
