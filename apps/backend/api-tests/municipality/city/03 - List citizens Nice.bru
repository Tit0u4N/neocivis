meta {
  name: List citizens Nice
  type: http
  seq: 33
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/citizens
  body: none
  auth: inherit
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  if (!baseUrl || !auth) {
    console.log('Missing url or Authorization');
    return;
  }
  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('No city in /api/municipality/user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/citizens`);
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns array of users", function() {
    const body = res.getBody();
    expect(body).to.be.an('array');
    expect(body.length).to.be.greaterThan(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
