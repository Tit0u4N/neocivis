meta {
  name: 01 - List media
  type: http
  seq: 1
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/media
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/media`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body is list of media for Nice", function() {
    const body = res.getBody();
    expect(body).to.be.an('array');
    expect(body.length).to.be.at.least(1);
    expect(body.every((m) => m.cityId === bru.getVar('cityNiceId'))).to.be.true;
    expect(body.every((m) => typeof m.url === 'string' && m.url.length > 0)).to.be.true;
    expect(body.every((m) => typeof m.storagePath === 'string')).to.be.true;
  });

  test("Seeded Nice carousel media is present", function() {
    const body = res.getBody();
    const ids = body.map((m) => m.id);
    expect(ids).to.include('a1000001-0000-4000-8000-000000000001');
    expect(ids).to.include('a1000001-0000-4000-8000-000000000002');
    expect(ids).to.include('a1000001-0000-4000-8000-000000000003');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
