meta {
  name: Change password
  type: http
  seq: 6
}

post {
  url: {{url}}/api/municipality/user/me/change-password
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

script:post-response {
  test("Status is 200 or 409", function() {
    expect([200, 409]).to.include(res.getStatus());
  });

  if (res.getStatus() === 200) {
    test("Body has success flag", function() {
      const body = res.getBody();
      expect(body).to.have.property('success', true);
    });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
