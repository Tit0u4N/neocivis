meta {
  name: Get me
  type: http
  seq: 3
}

get {
  url: {{url}}/api/municipality/user/me
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

script:post-response {
  test("Status is 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
  
  if (res.getStatus() === 200) {
    test("Body is a user", function() {
      const body = res.getBody();
      expect(body).to.be.an('object');
      expect(body).to.have.property('id');
      expect(body).to.have.property('firstName');
      expect(body).to.have.property('lastName');
      expect(body).to.have.property('role');
      expect(body).to.have.property('profilePictureUrl');
    });
    test("User is an admin", function() {
      const body = res.getBody();
      expect(body.role).to.be.equal('ADMIN');
    });
    test("profilePictureUrl is string or null", function() {
      const body = res.getBody();
      const url = body.profilePictureUrl;
      expect(url === null || typeof url === 'string').to.be.true;
    });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
