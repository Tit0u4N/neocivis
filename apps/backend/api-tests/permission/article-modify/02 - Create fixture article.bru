meta {
  name: article-modify - 02 - Create fixture article
  type: http
  seq: 2
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Fixture article (modify test)",
      "description": "Article créé par admin pour tester ARTICLE_MODIFY_PERMISSION"
    },
    "status": "draft"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  if (!adminToken) throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  const adminAuth = `Bearer ${adminToken}`;
  req.setHeader('Authorization', adminAuth);

  let cityId = bru.getVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) bru.setVar('permArticleId', body.id);
}

tests {
  test("Status is 201 — fixture article created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Article id saved", function() {
    expect(res.getBody()).to.have.property('id');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
