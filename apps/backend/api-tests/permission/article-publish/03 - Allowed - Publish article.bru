meta {
  name: article-publish - 03 - Allowed - Publish article
  type: http
  seq: 3
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Article perm-test",
      "description": "Créé pour le test ARTICLE_PUBLISH_PERMISSION"
    },
    "status": "draft"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!employeeToken) throw new Error('Missing tokenEmployee — collection pre-request did not run.');
  req.setHeader('Authorization', `Bearer ${employeeToken}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: `Bearer ${employeeToken}` } });
  const cityId = me.data?.city?.id;
  if (!cityId) throw new Error('Employee has no city context');
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) bru.setVar('permArticleId', body.id);
}

tests {
  test("Status is 201 — employee has ARTICLE_PUBLISH_PERMISSION", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Article created with id", function() {
    expect(res.getBody()).to.have.property('id');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
