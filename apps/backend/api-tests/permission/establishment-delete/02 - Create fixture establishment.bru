meta {
  name: establishment-delete - 02 - Create fixture establishment
  type: http
  seq: 2
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/establishment
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Fixture établissement (delete test)",
    "type": "education",
    "address": "3 rue du Test",
    "hours": "8h-16h",
    "phone": "0400000002"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  if (!adminToken) throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  const adminAuth = `Bearer ${adminToken}`;
  req.setHeader('Authorization', adminAuth);

  let cityId = bru.getVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/establishment`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) bru.setVar('permEstablishmentId', body.id);
}

tests {
  test("Status is 201 — fixture establishment created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
