meta {
  name: establishment-delete - 04 - Allowed - Delete establishment
  type: http
  seq: 4
}

delete {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/establishment/{{permEstablishmentId}}
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!employeeToken) throw new Error('Missing tokenEmployee — collection pre-request did not run.');
  req.setHeader('Authorization', `Bearer ${employeeToken}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: `Bearer ${employeeToken}` } });
  const cityId = me.data?.city?.id;
  if (!cityId) throw new Error('Employee has no city context');
  bru.setVar('cityNiceId', cityId);

  const estId = bru.getVar('permEstablishmentId');
  if (!estId) throw new Error('permEstablishmentId not set — run step 02 first');
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/establishment/${estId}`);
}

tests {
  test("Status is 200 — employee has ESTABLISHMENT_DELETE_PERMISSION", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns success", function() {
    expect(res.getBody()).to.have.property('success', true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
