meta {
  name: forum-thread-create - 02 - Create fixture category
  type: http
  seq: 2
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/threads/categories
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "emoji": "🧪",
    "label": "perm-test-category"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  if (!adminToken) throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  const adminAuth = `Bearer ${adminToken}`;
  req.setHeader('Authorization', adminAuth);

  let cityId = bru.getVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }

  // Idempotence: delete existing test category.
  const cats = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/threads/categories`, { headers: { Authorization: adminAuth } });
  const dup = (cats.data || []).find((c) => c.label === 'perm-test-category');
  if (dup) {
    await axios.delete(`${baseUrl}/api/municipality/cities/${cityId}/threads/categories/${dup.id}`, { headers: { Authorization: adminAuth } });
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/threads/categories`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) bru.setVar('permCategoryId', body.id);
}

tests {
  test("Status is 201 — fixture category created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Category id saved", function() {
    expect(res.getBody()).to.have.property('id');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
