meta {
  name: forum-thread-modify - 04 - Allowed - Modify thread
  type: http
  seq: 4
}

put {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/threads/{{permThreadId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "Thread perm-modify-test (modifié)",
    "body": "Modifié pour le test FORUM_THREAD_MODIFY_PERMISSION"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!employeeToken) throw new Error('Missing tokenEmployee — collection pre-request did not run.');
  req.setHeader('Authorization', `Bearer ${employeeToken}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: `Bearer ${employeeToken}` } });
  const cityId = me.data?.city?.id;
  if (!cityId) throw new Error('Employee has no city context');
  bru.setVar('cityNiceId', cityId);

  const threadId = bru.getVar('permThreadId');
  if (!threadId) throw new Error('permThreadId not set — run step 02 first');

  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/threads/${threadId}`);
}

tests {
  test("Status is 200 — employee has FORUM_THREAD_MODIFY_PERMISSION", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
