meta {
  name: forum-thread-unban-user - 02 - Ban citizen as admin fixture
  type: http
  seq: 2
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/threads/moderation/users/{{permCitizenId}}/ban
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  if (!adminToken) throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  const adminAuth = `Bearer ${adminToken}`;
  req.setHeader('Authorization', adminAuth);

  let cityId = bru.getVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }

  const citizens = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/citizens`, { headers: { Authorization: adminAuth } });
  const citizen = (citizens.data || [])[0];
  if (!citizen) throw new Error('No citizens found in city — seed required');
  bru.setVar('permCitizenId', String(citizen.id));

  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/threads/moderation/users/${citizen.id}/ban`);
}

tests {
  test("Status is 200 — citizen banned as fixture", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
