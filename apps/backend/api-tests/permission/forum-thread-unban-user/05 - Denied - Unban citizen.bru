meta {
  name: forum-thread-unban-user - 05 - Denied - Unban citizen
  type: http
  seq: 5
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/threads/moderation/users/{{permCitizenId}}/unban
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!adminToken) throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  if (!employeeToken) throw new Error('Missing tokenEmployee — collection pre-request did not run.');
  const adminAuth = `Bearer ${adminToken}`;

  let cityId = bru.getVar('cityNiceId');
  let roleId = bru.getVar('permRoleId');
  let employeeId = bru.getVar('permEmployeeId');
  let citizenId = bru.getVar('permCitizenId');

  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  if (!roleId) {
    const list = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/roles`, { headers: { Authorization: adminAuth } });
    const role = (list.data || []).find((r) => r.name === 'perm-forum-thread-unban');
    if (!role) throw new Error('perm-forum-thread-unban not found');
    roleId = role.id;
    bru.setVar('permRoleId', roleId);
  }
  if (!employeeId) {
    const employees = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/employees`, { headers: { Authorization: adminAuth } });
    const emp = (employees.data || []).find((u) => u.username === 'employee-nice1');
    if (!emp) throw new Error('employee-nice1 not found');
    employeeId = String(emp.id);
    bru.setVar('permEmployeeId', employeeId);
  }
  if (!citizenId) {
    const citizens = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/citizens`, { headers: { Authorization: adminAuth } });
    const citizen = (citizens.data || [])[0];
    if (!citizen) throw new Error('No citizens found');
    citizenId = String(citizen.id);
    bru.setVar('permCitizenId', citizenId);
  }

  // Re-ban so there is something to unban.
  try { await axios.post(`${baseUrl}/api/municipality/cities/${cityId}/threads/moderation/users/${citizenId}/ban`, null, { headers: { Authorization: adminAuth } }); } catch (_) {}

  await axios.delete(`${baseUrl}/api/municipality/cities/${cityId}/employees/${employeeId}/roles/${roleId}`, { headers: { Authorization: adminAuth } });

  req.setHeader('Authorization', `Bearer ${employeeToken}`);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/threads/moderation/users/${citizenId}/unban`);
}

tests {
  test("Status is 403 — role removed", function() {
    expect(res.getStatus()).to.equal(403);
  });
  test("Error mentions FORUM_THREAD_UNBAN_USER_PERMISSION", function() {
    expect(res.getBody()).to.have.property('error').that.includes('FORUM_THREAD_UNBAN_USER_PERMISSION');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
