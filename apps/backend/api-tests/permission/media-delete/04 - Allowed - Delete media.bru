meta {
  name: media-delete - 04 - Allowed - Delete media
  type: http
  seq: 4
}

delete {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/media/{{permMediaId}}
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!employeeToken) throw new Error('Missing tokenEmployee — collection pre-request did not run.');
  req.setHeader('Authorization', `Bearer ${employeeToken}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: `Bearer ${employeeToken}` } });
  const cityId = me.data?.city?.id;
  if (!cityId) throw new Error('Employee has no city context');
  bru.setVar('cityNiceId', cityId);

  const mediaId = bru.getVar('permMediaId');
  if (!mediaId) throw new Error('permMediaId not set — run step 02 first');

  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/media/${mediaId}`);
}

tests {
  test("Status is 404 not 403 — guard passed, employee has MEDIA_DELETE_PERMISSION", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
