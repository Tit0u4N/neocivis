meta {
  name: media-delete - 06 - Cleanup
  type: http
  seq: 6
}

delete {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/roles/{{permRoleId}}
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  if (!adminToken) throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  const adminAuth = `Bearer ${adminToken}`;
  req.setHeader('Authorization', adminAuth);

  let cityId = bru.getVar('cityNiceId');
  let roleId = bru.getVar('permRoleId');
  const mediaId = bru.getVar('permMediaId');

  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  if (!roleId) {
    const list = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/roles`, { headers: { Authorization: adminAuth } });
    const role = (list.data || []).find((r) => r.name === 'perm-media-delete');
    if (role) roleId = role.id;
  }

  // Safety: delete fixture media if step 04 didn't run.
  if (mediaId) {
    try { await axios.delete(`${baseUrl}/api/municipality/cities/${cityId}/media/${mediaId}`, { headers: { Authorization: adminAuth } }); } catch (_) {}
    bru.setVar('permMediaId', null);
  }

  if (!roleId) {
    req.setUrl(`${baseUrl}/api/municipality/permissions`);
    req.setMethod('GET');
    return;
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/roles/${roleId}`);
}

tests {
  test("Status is 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
