meta {
  name: Scenario - Admin creates test role
  type: http
  seq: 951
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/roles
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "E2E Publisher",
    "description": "Rôle E2E créé par Bruno",
    "permissions": ["ARTICLE_PUBLISH_PERMISSION"]
  }
}

script:pre-request {
  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const tokenKey = isCitizen ? 'tokenCitizen' : 'tokenAdmin';
  const token = bru.getVar(tokenKey);
  if (!token) {
    throw new Error(`Missing ${tokenKey} — collection pre-request did not run.`);
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  if (!baseUrl || !auth) {
    throw new Error('Missing url or Authorization (admin token expected)');
  }
  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city context');
  }
  bru.setVar('cityNiceId', cityId);

  // Hygiène : si le rôle E2E existe déjà, on le supprime pour repartir propre.
  const list = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/roles`, { headers: { Authorization: auth } });
  const dup = (list.data || []).find((r) => r.name === 'E2E Publisher');
  if (dup) {
    await axios.delete(`${baseUrl}/api/municipality/cities/${cityId}/roles/${dup.id}`, { headers: { Authorization: auth } });
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/roles`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) {
    bru.setVar('e2eRoleId', body.id);
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Created role grants ARTICLE_PUBLISH_PERMISSION", function() {
    const body = res.getBody();
    expect(body.permissions).to.include('ARTICLE_PUBLISH_PERMISSION');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
