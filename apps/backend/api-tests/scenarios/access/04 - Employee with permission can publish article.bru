meta {
  name: Scenario - Employee with permission can publish article
  type: http
  seq: 954
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Article E2E créé par Bruno",
      "description": "Test du gating de permission ARTICLE_PUBLISH_PERMISSION"
    },
    "status": "draft"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!employeeToken) {
    throw new Error('Missing tokenEmployee — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${employeeToken}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${employeeToken}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Employee has no city context');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) {
    bru.setVar('e2eArticleId', body.id);
  }
}

tests {
  test("Status is 201 (employee has ARTICLE_PUBLISH_PERMISSION via assigned role)", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Article was created", function() {
    const body = res.getBody();
    expect(body).to.have.property('id');
    expect(body).to.have.property('translations').that.is.an('array');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
