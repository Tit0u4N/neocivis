meta {
  name: Scenario - Admin unassigns role then employee gets 403 on publish
  type: http
  seq: 955
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Devrait échouer (rôle retiré)",
      "description": "Permission gate test"
    },
    "status": "draft"
  }
}

script:pre-request {
  // Pre-script en deux étapes :
  //   1. en tant qu'ADMIN : retire le rôle E2E à l'employé,
  //   2. la requête principale s'exécute en tant qu'EMPLOYEE et doit 403.
  // On lit les deux tokens depuis les variables runtime peuplées par le
  // pre-script central (collection.bru).
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const adminToken = bru.getVar('tokenAdmin');
  const employeeToken = bru.getVar('tokenEmployee');
  if (!adminToken) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run or failed.');
  }
  if (!employeeToken) {
    throw new Error('Missing tokenEmployee — collection pre-request did not run or failed.');
  }
  const adminAuth = `Bearer ${adminToken}`;

  let cityId = bru.getVar('cityNiceId');
  let roleId = bru.getVar('e2eRoleId');
  let employeeId = bru.getVar('e2eEmployeeId');

  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: adminAuth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  if (!employeeId) {
    const employees = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/employees`, { headers: { Authorization: adminAuth } });
    const employee = (employees.data || []).find((u) => u.username === 'employee-nice1');
    employeeId = String(employee.id);
    bru.setVar('e2eEmployeeId', employeeId);
  }
  if (!roleId) {
    const list = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/roles`, { headers: { Authorization: adminAuth } });
    const role = (list.data || []).find((r) => r.name === 'E2E Publisher');
    if (!role) {
      throw new Error('E2E Publisher role missing, run scenario 951 first');
    }
    roleId = role.id;
    bru.setVar('e2eRoleId', roleId);
  }

  // 1. Admin retire le rôle de l'employé.
  await axios.delete(`${baseUrl}/api/municipality/cities/${cityId}/employees/${employeeId}/roles/${roleId}`, { headers: { Authorization: adminAuth } });

  // 2. La requête principale part en tant qu'employé.
  req.setHeader('Authorization', `Bearer ${employeeToken}`);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles`);
}

tests {
  test("Status is 403 (permission removed)", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Returns ApiErrorDto mentioning the missing permission", function() {
    const body = res.getBody();
    expect(body).to.have.property('error').that.includes('ARTICLE_PUBLISH_PERMISSION');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
