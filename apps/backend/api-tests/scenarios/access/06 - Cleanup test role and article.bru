meta {
  name: Scenario - Cleanup test role and article
  type: http
  seq: 956
}

delete {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/roles/{{e2eRoleId}}
  body: none
  auth: none
}

script:pre-request {
  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const tokenKey = isCitizen ? 'tokenCitizen' : 'tokenAdmin';
  const token = bru.getVar(tokenKey);
  if (!token) {
    throw new Error(`Missing ${tokenKey} — collection pre-request did not run.`);
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  let cityId = bru.getVar('cityNiceId');
  let roleId = bru.getVar('e2eRoleId');
  const articleId = bru.getVar('e2eArticleId');

  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/municipality/user/me`, { headers: { Authorization: auth } });
    cityId = me.data?.city?.id;
    bru.setVar('cityNiceId', cityId);
  }
  if (!roleId) {
    const list = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/roles`, { headers: { Authorization: auth } });
    const role = (list.data || []).find((r) => r.name === 'E2E Publisher');
    if (role) {
      roleId = role.id;
    }
  }

  // Cleanup article (admin bypass).
  if (articleId) {
    try {
      await axios.delete(`${baseUrl}/api/municipality/cities/${cityId}/articles/${articleId}`, { headers: { Authorization: auth } });
    } catch (_err) {
      // ignore — article might already be gone.
    }
  }

  if (!roleId) {
    // Rien à nettoyer côté rôle, on cible une URL inoffensive.
    req.setUrl(`${baseUrl}/api/municipality/permissions`);
    req.setMethod('GET');
    return;
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/roles/${roleId}`);
}

tests {
  test("Status is 200 (role deleted) or 404 (already gone)", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
