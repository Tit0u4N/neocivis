meta {
  name: Scenario - Change password (send email)
  type: http
  seq: 3
}

post {
  url: {{url}}/api/citizen/user/me/change-password
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

tests {
  test("Change password accepted (200) or Keycloak not reachable/SMTP not configured (409)", function() {
    // 409 in dev = Keycloak rejected the call (SMTP not configured, or
    // neocivis-citizen-app missing redirect URI). Check res.body.error for details.
    expect([200, 409]).to.include(res.getStatus());
  });

  if (res.getStatus() === 200) {
    test("Body has success flag", function() {
      const body = res.getBody();
      expect(body).to.have.property('success', true);
    });
  }

  if (res.getStatus() === 409) {
    test("409 — Keycloak error detail is present", function() {
      const body = res.getBody();
      expect(body).to.have.property('error');
      console.warn('[change-password] Keycloak error:', body.error);
    });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
