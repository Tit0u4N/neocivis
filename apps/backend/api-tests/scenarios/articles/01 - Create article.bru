meta {
  name: 01 - Create article
  type: http
  seq: 931
}

post {
  url: {{url}}/api/municipality/articles
  body: json
  auth: none
}

script:pre-request {
  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const tokenKey = isCitizen ? 'tokenCitizen' : 'tokenAdmin';
  const token = bru.getVar(tokenKey);
  if (!token) {
    throw new Error(`Missing ${tokenKey} — collection pre-request did not run.`);
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Bruno test article",
      "description": "Created by Bruno scenario",
      "content": []
    },
    "status": "draft"
  }
}

script:post-response {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Saves article id", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body).to.have.property('id');
    bru.setVar('articleId', body.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

