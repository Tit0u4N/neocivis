meta {
  name: 01 - Create article
  type: http
  seq: 931
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles
  body: json
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles`);
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Bruno test article",
      "description": "Created by Bruno scenario",
      "content": []
    },
    "status": "draft"
  }
}

script:post-response {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Saves article id", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body).to.have.property('id');
    expect(body).to.have.property('cityId');
    bru.setVar('articleId', body.id);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
