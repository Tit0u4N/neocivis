meta {
  name: 03 - Get article by id
  type: http
  seq: 933
}

get {
  url: {{url}}/api/municipality/articles/{{articleId}}
  body: none
  auth: none
}

script:pre-request {
  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const tokenKey = isCitizen ? 'tokenCitizen' : 'tokenAdmin';
  const token = bru.getVar(tokenKey);
  if (!token) {
    throw new Error(`Missing ${tokenKey} — collection pre-request did not run.`);
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  if (!bru.getVar('articleId')) {
    throw new Error('Missing articleId. Run "01 - Create article" first.');
  }
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body has id", function() {
    const body = res.getBody();
    expect(body).to.have.property('id');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
