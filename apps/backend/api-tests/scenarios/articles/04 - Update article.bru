meta {
  name: 04 - Update article
  type: http
  seq: 934
}

put {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles/{{articleId}}
  body: json
  auth: none
}

body:json {
  {
    "translation": {
      "locale": "fr",
      "title": "Bruno test article (updated)",
      "description": "Updated by Bruno scenario",
      "content": []
    }
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const articleId = bru.getVar('articleId');
  if (!articleId) {
    throw new Error('Missing articleId. Run "01 - Create article" first.');
  }

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles/${articleId}`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
