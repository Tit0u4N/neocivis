meta {
  name: 05 - Add translation (en)
  type: http
  seq: 935
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/articles/{{articleId}}/translations
  body: json
  auth: none
}

body:json {
  {
    "locale": "en",
    "title": "Bruno test article (EN)",
    "description": "English translation",
    "content": []
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const articleId = bru.getVar('articleId');
  if (!articleId) {
    throw new Error('Missing articleId. Run "01 - Create article" first.');
  }

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/articles/${articleId}/translations`);
}

script:post-response {
  test("Status is 201 or 409", function() {
    expect([201, 409]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
