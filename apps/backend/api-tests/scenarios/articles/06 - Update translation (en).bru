meta {
  name: 06 - Update translation (en)
  type: http
  seq: 936
}

put {
  url: {{url}}/api/municipality/articles/{{articleId}}/translations/en
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Bruno test article (EN updated)"
  }
}

script:pre-request {
  if (!bru.getVar('articleId')) {
    throw new Error('Missing articleId. Run "01 - Create article" first.');
  }
}

script:post-response {
  test("Status is 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

