meta {
  name: 09 - Delete article
  type: http
  seq: 939
}

delete {
  url: {{url}}/api/municipality/articles/{{articleId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar('articleId')) {
    throw new Error('Missing articleId. Run "01 - Create article" first.');
  }
}

script:post-response {
  test("Status is 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

