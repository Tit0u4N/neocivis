meta {
  name: Scenario - citizen leaves then rejoins Nice (hygienic)
  type: http
  seq: 911
}

post {
  url: {{url}}/api/citizen/cities/{{cityNiceId}}/join
  body: none
  auth: none
}

script:pre-request {
  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const tokenKey = isCitizen ? 'tokenCitizen' : 'tokenAdmin';
  const token = bru.getVar(tokenKey);
  if (!token) {
    throw new Error(`Missing ${tokenKey} — collection pre-request did not run.`);
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  if (!baseUrl || !auth) {
    throw new Error('Missing url or Authorization');
  }

  const me = await axios.get(`${baseUrl}/api/citizen/user/me`, { headers: { Authorization: auth } });
  const memberships = me.data?.memberships ?? [];
  const nice = Array.isArray(memberships) ? memberships.find((m) => m && m.name === 'Nice') : null;
  if (!nice?.id) {
    throw new Error('Nice membership not found in /user/me');
  }

  bru.setVar('cityNiceId', nice.id);
  // Hygiène: on force d'abord un leave, puis on join.
  await axios.delete(`${baseUrl}/api/citizen/cities/${nice.id}/leave`, { headers: { Authorization: auth } });
  req.setUrl(`${baseUrl}/api/citizen/cities/${nice.id}/join`);
}

tests {
  test("Join returns 200 with success boolean", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property('success');
    expect(body.success).to.be.a('boolean');
  });
}

script:post-response {
  // Hygiène: on s'assure que l'utilisateur reste membre à la fin.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const auth = req.getHeader('Authorization');
  const cityId = bru.getVar('cityNiceId');
  if (baseUrl && auth && cityId) {
    await axios.post(`${baseUrl}/api/citizen/cities/${cityId}/join`, null, { headers: { Authorization: auth } });
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

