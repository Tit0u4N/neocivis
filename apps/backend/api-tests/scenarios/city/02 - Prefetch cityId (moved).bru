meta {
  name: (moved) Prefetch cityId via municipality user/me
  type: http
  seq: 921
}

get {
  url: {{url}}/api/municipality/user/me
  body: none
  auth: none
}

script:pre-request {
  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const tokenKey = isCitizen ? 'tokenCitizen' : 'tokenAdmin';
  const token = bru.getVar(tokenKey);
  if (!token) {
    throw new Error(`Missing ${tokenKey} — collection pre-request did not run.`);
  }
  req.setHeader('Authorization', `Bearer ${token}`);
}

script:post-response {
  const body = res.getBody();
  if (body && body.city && body.city.id) {
    bru.setEnvVar('cityNiceId', body.city.id);
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("cityNiceId set from user/me city", function() {
    expect(bru.getEnvVar('cityNiceId')).to.be.a('string');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

