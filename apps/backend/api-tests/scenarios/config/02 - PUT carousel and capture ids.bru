meta {
  name: 02 - PUT carousel and capture ids
  type: http
  seq: 2
}

put {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/config/carousel
  body: json
  auth: none
}

headers {
  content-type: application/json
}

script:pre-request {
  const axios = require('axios');

  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);

  const media = await axios.get(`${baseUrl}/api/municipality/cities/${cityId}/media`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const list = media.data;
  const m1 = list.find((m) => m.id === 'a1000001-0000-4000-8000-000000000001');
  const m2 = list.find((m) => m.id === 'a1000001-0000-4000-8000-000000000002');
  if (!m1?.url || !m2?.url) {
    throw new Error('Missing seeded Nice carousel media (ids 001/002) in /media list.');
  }

  const item1Id = bru.interpolate('{{$randomUUID}}');
  const item2Id = bru.interpolate('{{$randomUUID}}');
  bru.setVar('carouselItem1Id', item1Id);
  bru.setVar('carouselItem2Id', item2Id);
  bru.setVar('carouselMedia1Url', m1.url);
  bru.setVar('carouselMedia2Url', m2.url);

  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/config/carousel`);
  req.setBody(
    JSON.stringify([
      {
        id: item1Id,
        imageUrl: m1.url,
        order: 0,
        translations: [{ locale: 'fr', title: 'E2E carousel 1', description: 'desc', tag: 'tag' }],
      },
      {
        id: item2Id,
        imageUrl: m2.url,
        order: 1,
        translations: [{ locale: 'fr', title: 'E2E carousel 2', description: 'desc', tag: 'tag' }],
      },
    ]),
  );
}

tests {
  test('Status is 200', function () {
    expect(res.getStatus()).to.equal(200);
  });

  test('Response is the saved carousel array', function () {
    const body = res.getBody();
    expect(body).to.be.an('array');
    expect(body.length).to.equal(2);
    expect(body[0].id).to.equal(bru.getVar('carouselItem1Id'));
    expect(body[1].id).to.equal(bru.getVar('carouselItem2Id'));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

