meta {
  name: 04 - PUT carousel remove item1 (cleanup)
  type: http
  seq: 4
}

put {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/config/carousel
  body: json
  auth: none
}

headers {
  content-type: application/json
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);

  const item2Id = bru.getVar('carouselItem2Id');
  const m2Url = bru.getVar('carouselMedia2Url');
  if (!item2Id || !m2Url) {
    throw new Error('Missing carouselItem2Id or carouselMedia2Url from previous steps.');
  }

  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/config/carousel`);
  req.setBody(
    JSON.stringify([
      {
        id: item2Id,
        imageUrl: m2Url,
        order: 0,
        translations: [{ locale: 'fr', title: 'E2E carousel 2', description: 'desc', tag: 'tag' }],
      },
    ]),
  );
}

tests {
  test('Status is 200', function () {
    expect(res.getStatus()).to.equal(200);
  });

  test('Response contains only item2', function () {
    const body = res.getBody();
    expect(body).to.be.an('array');
    expect(body.length).to.equal(1);
    expect(body[0].id).to.equal(bru.getVar('carouselItem2Id'));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

