meta {
  name: 01 - List seeded establishments
  type: http
  seq: 961
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/establishment/all
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const me = await axios.get(`${baseUrl}/api/municipality/user/me`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const cityId = me.data?.city?.id;
  if (!cityId) {
    throw new Error('Admin has no city in /user/me');
  }
  bru.setVar('cityNiceId', cityId);
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/establishment/all`);
}

script:post-response {
  test('Status is 200', function () {
    expect(res.getStatus()).to.equal(200);
  });

  test('Body is an array', function () {
    const body = res.getBody();
    expect(body).to.be.an('array');
  });

  test('Seeded Nice establishments are present', function () {
    const body = res.getBody();
    const ids = body.map((e) => e.id);
    expect(ids).to.include('e5700001-0000-4000-8000-000000000001');
    expect(ids).to.include('e5700001-0000-4000-8000-000000000002');
    expect(ids).to.include('e5700001-0000-4000-8000-000000000003');
    expect(ids).to.include('e5700001-0000-4000-8000-000000000004');
  });

  test('Establishments have no cityId in DTO', function () {
    const body = res.getBody();
    expect(body.every((e) => !('cityId' in e))).to.be.true;
  });

  // Save first seeded id for the next test
  const body = res.getBody();
  if (body.length > 0) {
    bru.setVar('seededEstablishmentId', body[0].id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
