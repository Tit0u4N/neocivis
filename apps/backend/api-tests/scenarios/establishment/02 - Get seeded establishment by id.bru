meta {
  name: 02 - Get seeded establishment by id
  type: http
  seq: 962
}

get {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/establishment/e5700001-0000-4000-8000-000000000001
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const cityId = bru.getVar('cityNiceId');
  if (!cityId) {
    throw new Error('Missing cityNiceId — run "01 - List seeded establishments" first.');
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/establishment/e5700001-0000-4000-8000-000000000001`);
}

script:post-response {
  test('Status is 200', function () {
    expect(res.getStatus()).to.equal(200);
  });

  test('Body matches seeded Mairie', function () {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.id).to.equal('e5700001-0000-4000-8000-000000000001');
    expect(body.type).to.equal('town_hall');
    expect(body).to.not.have.property('cityId');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
