meta {
  name: 03 - Create establishment
  type: http
  seq: 963
}

post {
  url: {{url}}/api/municipality/cities/{{cityNiceId}}/establishment
  body: json
  auth: none
}

body:json {
  {
    "name": "Piscine municipale E2E",
    "type": "sport",
    "address": "42 Avenue du Test",
    "hours": "Lun-Dim 7h-21h",
    "phone": "04 93 00 00 00"
  }
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenAdmin');
  if (!token) {
    throw new Error('Missing tokenAdmin — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const cityId = bru.getVar('cityNiceId');
  if (!cityId) {
    throw new Error('Missing cityNiceId — run "01 - List seeded establishments" first.');
  }
  req.setUrl(`${baseUrl}/api/municipality/cities/${cityId}/establishment`);
}

script:post-response {
  test('Status is 201', function () {
    expect(res.getStatus()).to.equal(201);
  });

  test('Body has expected fields', function () {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body).to.have.property('id');
    expect(body.name).to.equal('Piscine municipale E2E');
    expect(body.type).to.equal('sport');
    expect(body).to.not.have.property('cityId');
  });

  const body = res.getBody();
  if (body && body.id) {
    bru.setVar('e2eEstablishmentId', body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
