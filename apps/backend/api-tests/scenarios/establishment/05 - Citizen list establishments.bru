meta {
  name: 05 - Citizen list establishments
  type: http
  seq: 965
}

get {
  url: {{url}}/api/citizen/cities/{{cityNiceId}}/establishment/all
  body: none
  auth: none
}

script:pre-request {
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('url');
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  let cityId = bru.getVar('cityNiceId') ?? bru.getEnvVar('cityNiceId');
  if (!cityId) {
    const me = await axios.get(`${baseUrl}/api/citizen/user/me`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    const memberships = me.data?.memberships ?? [];
    const nice = Array.isArray(memberships) ? memberships.find((m) => m && m.name === 'Nice') : null;
    if (!nice?.id) {
      throw new Error('Nice membership not found in /user/me');
    }
    cityId = nice.id;
    bru.setVar('cityNiceId', cityId);
  }
  req.setUrl(`${baseUrl}/api/citizen/cities/${cityId}/establishment/all`);
}

script:post-response {
  test('Status is 200', function () {
    expect(res.getStatus()).to.equal(200);
  });

  test('Returns array with seeded establishments', function () {
    const body = res.getBody();
    expect(body).to.be.an('array');
    const ids = body.map((e) => e.id);
    expect(ids).to.include('e5700001-0000-4000-8000-000000000001');
  });

  test('Establishments have no cityId in DTO', function () {
    const body = res.getBody();
    expect(body.every((e) => !('cityId' in e))).to.be.true;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
