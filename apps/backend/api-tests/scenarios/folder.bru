meta {
  name: scenarios
  seq: 900
}

auth {
  mode: none
}

script:pre-request {
  const axios = require('axios');

  const tokenUrl = bru.getEnvVar('tokenUrl');
  const clientId = bru.getEnvVar('clientId');
  const passwordCitizen = bru.getEnvVar('password_citizen');
  const passwordMunicipality = bru.getEnvVar('password_municipality');
  const usernameCitizen = bru.getEnvVar('username_citizen');
  const usernameMunicipality = bru.getEnvVar('username_municipality');

  if (!tokenUrl || !clientId) {
    console.log("⚠️ Variables d'environnement manquantes (tokenUrl/clientId).");
    return;
  }

  const url = req.getUrl ? req.getUrl() : '';
  const isCitizen = typeof url === 'string' && url.includes('/api/citizen/');
  const isMunicipality = typeof url === 'string' && url.includes('/api/municipality/');

  // Par défaut, on n'injecte rien si on ne sait pas.
  if (!isCitizen && !isMunicipality) {
    return;
  }

  const username = isCitizen ? usernameCitizen : usernameMunicipality;
  const password = isCitizen ? passwordCitizen : passwordMunicipality;

  if (!username || !password) {
    console.log('⚠️ Variables user/pass manquantes pour le scope demandé.');
    return;
  }

  const data = `grant_type=password&client_id=${encodeURIComponent(clientId)}&username=${encodeURIComponent(
    username,
  )}&password=${encodeURIComponent(password)}`;

  try {
    const response = await axios.post(tokenUrl, data, {
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    });
    const token = response.data.access_token;
    req.setHeader('Authorization', `Bearer ${token}`);
  } catch (error) {
    console.error(
      "❌ Erreur lors de la récupération du token Keycloak:",
      error.response ? error.response.data : error.message,
    );
  }
}

