meta {
  name: 06 - Citizen adds reaction
  type: http
  seq: 976
}

post {
  url: {{url}}/api/citizen/cities/{{cityNiceId}}/threads/{{e2eThreadId}}/messages/{{e2eMessageId}}/reactions
  body: json
  auth: none
}

body:json {
  {
    "emoji": "👍"
  }
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const baseUrl = bru.getEnvVar('url');
  const cityId = bru.getVar('cityNiceId');
  const threadId = bru.getVar('e2eThreadId');
  const messageId = bru.getVar('e2eMessageId');
  if (!cityId || !threadId || !messageId) {
    throw new Error('Missing required vars — run steps 04-05 first.');
  }
  req.setUrl(`${baseUrl}/api/citizen/cities/${cityId}/threads/${threadId}/messages/${messageId}/reactions`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Reaction 👍 is recorded", function() {
    const reactions = res.getBody().reactions;
    const thumbsUp = reactions.find((r) => r.emoji === '👍');
    expect(thumbsUp).to.not.be.undefined;
    expect(thumbsUp.userIds.length).to.be.greaterThan(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
