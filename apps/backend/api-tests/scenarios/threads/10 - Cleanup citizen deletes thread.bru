meta {
  name: 10 - Cleanup citizen deletes thread
  type: http
  seq: 980
}

delete {
  url: {{url}}/api/citizen/cities/{{cityNiceId}}/threads/{{e2eThreadId}}
  body: none
  auth: none
}

script:pre-request {
  const token = bru.getVar('tokenCitizen');
  if (!token) {
    throw new Error('Missing tokenCitizen — collection pre-request did not run.');
  }
  req.setHeader('Authorization', `Bearer ${token}`);

  const baseUrl = bru.getEnvVar('url');
  const cityId = bru.getVar('cityNiceId');
  const threadId = bru.getVar('e2eThreadId');
  if (!cityId || !threadId) {
    throw new Error('Missing cityNiceId or e2eThreadId — run step 04 first.');
  }
  req.setUrl(`${baseUrl}/api/citizen/cities/${cityId}/threads/${threadId}`);
}

script:post-response {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Thread is soft-deleted", function() {
    expect(res.getBody().deleted).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
