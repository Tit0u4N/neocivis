{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "azureFunctions": {
    "main": "dist/index.js"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "start": "func start",
    "clean": "rimraf dist",
    "clean:node_modules": "npx rimraf node_modules",
    "prestart": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "dev": "concurrently \"bun run watch\" \"bun run start\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./src/infrastructure/db/migrate.ts",
    "db:reset": "bun run ./src/infrastructure/db/reset.ts",
    "db:seeding": "bun run ./src/core/seeding.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@azure/cosmos": "^4.5.1",
    "@azure/functions": "^4.11.0",
    "@azure/storage-blob": "^12.28.0",
    "@marplex/hono-azurefunc-adapter": "^1.0.1",
    "@repo/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.6",
    "postgres": "^3.4.9",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  }
}
