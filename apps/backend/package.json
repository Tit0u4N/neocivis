{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "azureFunctions": {
    "main": "dist/index.js"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "start": "func start",
    "clean": "rimraf dist",
    "clean:node_modules": "npx rimraf node_modules",
    "prestart": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "dev": "concurrently \"npm run watch\" \"npm run start\""
  },
  "dependencies": {
    "@azure/functions": "^4.11.0",
    "@repo/dto": "*",
    "@marplex/hono-azurefunc-adapter": "^1.0.1",
    "hono": "^4.11.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
