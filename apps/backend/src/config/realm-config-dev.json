        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["EMPLOYEE", "SIGNAL_VIEW_PERMISSION", "SIGNAL_CREATE_PERMISSION", "SIGNAL_MODIFY_PERMISSION"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
