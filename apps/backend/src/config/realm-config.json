{
  "realm": "neocivis",
  "enabled": true,
  "registrationAllowed": true,
  "verifyEmail": true,
  "clients": [
    {
      "clientId": "neocivis-citizen-app",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8081/*",
        "neocivis-citizen-app://*",
        "https://citizen-app-dev.neocivis.cloud/*",
        "https://citizen-app.neocivis.cloud/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "https://citizen-app-dev.neocivis.cloud/",
        "https://citizen-app.neocivis.cloud/",
        "neocivis-citizen-app://"
      ],
      "directAccessGrantsEnabled": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "api-hono", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "neocivis-townhall-app",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://townhall-dev.neocivis.cloud/",
        "https://townhall.neocivis.cloud/"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://townhall-dev.neocivis.cloud/",
        "https://townhall.neocivis.cloud/"
      ],
      "directAccessGrantsEnabled": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "api-hono", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrateur de la mairie"
      },
      {
        "name": "EMPLOYEE",
        "description": "Eployé de la mairie"
      },
      {
        "name": "CITIZEN",
        "description": "Citoyen de la ville"
      },
      {
        "name": "SIGNAL_VIEW_PERMISSION",
        "description": "Voir les signalements"
      },
      {
        "name": "SIGNAL_CREATE_PERMISSION",
        "description": "Créer des signalements"
      },
      {
        "name": "SIGNAL_MODIFY_PERMISSION",
        "description": "Modifier des signalements"
      },
      {
        "name": "FORUM_THREAD_CREATE_PERMISSION",
        "description": "Créer un thread sur le forum"
      },
      {
        "name": "FORUM_THREAD_DELETE_PERMISSION",
        "description": "Supprimer un thread sur le forum"
      },
      {
        "name": "FORUM_THREAD_MODIFY_PERMISSION",
        "description": "Modifier un thread sur le forum"
      },
      {
        "name": "FORUM_THREAD_DELETE_MESSAGE_PERMISSION",
        "description": "Supprimer un message dans un thread sur le forum"
      },
      {
        "name": "FORUM_THREAD_BAN_USER_PERMISSION",
        "description": "Bannir un utilisateur d'un thread sur le forum"
      },
      {
        "name": "FORUM_THREAD_UNBAN_USER_PERMISSION",
        "description": "Débannir un utilisateur d'un thread sur le forum"
      },
      {
        "name": "PAGE_CITY_HALL_MODIFY_PERMISSION",
        "description": "Modifier des éléments de la page mairie"
      },
      {
        "name": "PAGE_CITY_HALL_ANNOUNCE_PERMISSION",
        "description": "Créer des annonces sur la page mairie"
      },
      {
        "name": "NOTIFICATION_SEND_PERMISSION",
        "description": "Envoyer des notifications aux utilisateurs"
      },
      {
        "name": "WEBHOOK_PERMISSION",
        "description": "Gestion des webhook"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "api-hono",
      "description": "",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-hono",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "included.custom.audience": "neocivis-api"
          }
        }
      ]
    }
  ],
  "smtpServer": {
