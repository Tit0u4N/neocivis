{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": []
  },
  "paths": {
    "@/*": [
      "./*"
    ],
    "@/utils/*": [
      "./src/utils/*"
    ],
    "@/components/*": [
      "./src/components/*"
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
