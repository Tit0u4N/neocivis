{
  "name": "neocivis",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/frontend/*",
    "packages/shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint": "biome lint .",
    "format": "biome check . --write",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "turbo": "^2.6.1"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.9.0"
  }
}