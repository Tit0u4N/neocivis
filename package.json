{
  "name": "neocivis",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/frontend/*",
    "packages/shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean && npx rimraf node_modules",
    "clean:node_modules": "turbo run clean:node_modules && npx rimraf node_modules",
    "lint": "biome lint .",
    "format": "biome check . --write --staged",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "husky": "^9.1.7",
    "shadcn": "^4.2.0",
    "turbo": "^2.6.1"
  },
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "keycloak-connect": "^26.1.1"
  }
}
